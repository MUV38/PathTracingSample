#usda 1.0
(defaultPrim = "PreviewRoom"
	metersPerUnit = 1
	upAxis = "Y")
def Xform "PreviewRoom" {
	def Scope "Looks" {
		def Material "BlueMetal" {
			token outputs:surface.connect = </PreviewRoom/Looks/BlueMetal/Shader.outputs:surface>
			def Shader "Shader" {
				uniform token info:id = "UsdPreviewSurface"
				color3f inputs:diffuseColor = (0.35, 0.65, 0.8)
				float inputs:metallic = 1
				float inputs:roughness = 0.18
				token outputs:surface
			}
		}
		def Material "Mirror" {
			token outputs:surface.connect = </PreviewRoom/Looks/Mirror/Shader.outputs:surface>
			def Shader "Shader" {
				uniform token info:id = "UsdPreviewSurface"
				color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
				float inputs:metallic = 1
				float inputs:roughness = 0
				token outputs:surface
			}
		}
	}
	def Xform "Floor" (prepend references = @UnitCube.usda@
	instanceable = true) {
		double3 xformOp:translate = (0, -0.1, 0)
		float3 xformOp:scale = (6, 0.2, 5)
		uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
		color3f[] primvars:displayColor = [(0.45, 0.48, 0.52)] (interpolation = "constant")
	}
