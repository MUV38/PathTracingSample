<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup Label="Globals"><ProjectGuid>{F4680A75-5D93-4AFB-A63A-79DC02CCB6C8}</ProjectGuid></PropertyGroup>
	<Import Project="..\..\build_support\Cpp.props" />
	<PropertyGroup>
		<DxcExecutable>$([System.String]::Copy('$(WindowsSDK_ExecutablePath_x64)').Split(';')[0])\dxc.exe</DxcExecutable>
		<StreamlineRoot>$(RepositoryRoot)packages\Streamline-2.14.16\</StreamlineRoot>
	</PropertyGroup>
	<Import Project="..\..\build_support\Streamline.local.props" Condition="Exists('..\..\build_support\Streamline.local.props')" />
	<ItemDefinitionGroup>
		<ClCompile><AdditionalIncludeDirectories>$(StreamlineRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile>
	</ItemDefinitionGroup>
	<ItemGroup>
		<ClCompile Include="Main.cpp" />
		<ClCompile Include="UsdKitchen.cpp" />
		<ClCompile Include="MeshRaytracer.cpp" />
		<ClCompile Include="EnvironmentMap.cpp" />
		<ClCompile Include="MeshLight.cpp" />
		<ClCompile Include="RayReconstruction.cpp" />
		<ClInclude Include="RayReconstruction.h" />
		<ClInclude Include="RayReconstruction.hlsli" />
		<ClInclude Include="MeshLight.h" />
		<ClInclude Include="MeshLight.hlsli" />
		<ClInclude Include="UsdKitchen.h" />
		<ClInclude Include="MeshRaytracer.h" />
		<ClInclude Include="Lighting.h" />
		<ClInclude Include="EnvironmentMap.h" />
		<ClInclude Include="PathTracing.h" />
		<ClInclude Include="Pbr.hlsli" />
		<ClInclude Include="RestirDI.hlsli" />
		<ClInclude Include="RestirGI.hlsli" />
		<ClInclude Include="GiTemporal.hlsli" />
		<ClInclude Include="PtHybrid.hlsli" />
		<ClInclude Include="PtReservoir.hlsli" />
		<ClInclude Include="GiSpatial.hlsli" />
		<ClInclude Include="RestirPasses.hlsli" />
		<ClInclude Include="RussianRoulette.hlsli" />
		<ClInclude Include="GgxEnergy.hlsli" />
		<ClInclude Include="GgxEnergyLut.h" />
		<ClInclude Include="EnvironmentSampling.hlsli" />
		<ClInclude Include="RectangleLight.hlsli" />
		<ProjectReference Include="..\..\common\SampleFramework.vcxproj"><Project>{15AB62DB-3209-43ED-874F-71EFA2815BAA}</Project></ProjectReference>
		<CustomBuild Include="Scene.hlsl">
			<Command>"$(DxcExecutable)" -T lib_6_5 -HV 2021 -WX -Zi -Qembed_debug -Fo "$(OutDir)Scene.dxil" "%(FullPath)"</Command>
			<Outputs>$(OutDir)Scene.dxil</Outputs>
			<AdditionalInputs>$(ProjectDir)Pbr.hlsli;$(ProjectDir)RayReconstruction.hlsli;$(ProjectDir)RestirDI.hlsli;$(ProjectDir)RestirGI.hlsli;$(ProjectDir)GiTemporal.hlsli;$(ProjectDir)PtHybrid.hlsli;$(ProjectDir)PtReservoir.hlsli;$(ProjectDir)GiSpatial.hlsli;$(ProjectDir)RestirPasses.hlsli;$(ProjectDir)RussianRoulette.hlsli;$(ProjectDir)GgxEnergy.hlsli;$(ProjectDir)EnvironmentSampling.hlsli;$(ProjectDir)RectangleLight.hlsli;$(ProjectDir)MeshLight.hlsli;%(AdditionalInputs)</AdditionalInputs>
			<Message>Compiling converted-mesh DXR shaders</Message>
		</CustomBuild>
		<Content Include="$(RepositoryRoot)assets\PreviewRoom.ptscene">
			<Link>assets\PreviewRoom.ptscene</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<Import Project="..\..\build_support\Cpp.targets" />
	<Target Name="CheckStreamline" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(StreamlineRoot)include\sl.h')" Text="Streamline SDK 2.14.16 is missing. Run tools/RestoreStreamline.ps1." />
	</Target>
	<Target Name="CopyStreamline" AfterTargets="Build" Condition="'$(StreamlineRuntimeEnabled)'=='true'">
		<ItemGroup>
			<StreamlineDll Include="$(StreamlineRoot)bin\x64\sl.interposer.dll;$(StreamlineRoot)bin\x64\sl.common.dll;$(StreamlineRoot)bin\x64\sl.dlss_d.dll;$(StreamlineRoot)bin\x64\nvngx_dlssd.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(StreamlineDll)" DestinationFolder="$(OutDir)Streamline\" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(StreamlineRoot)license.txt" DestinationFiles="$(OutDir)Streamline\streamline-license.txt" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(StreamlineRoot)bin\x64\nvngx_dlss.license.txt" DestinationFolder="$(OutDir)Streamline\" SkipUnchangedFiles="true" />
	</Target>
</Project>
